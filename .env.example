# ── Anthropic API ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Gmail SMTP ───────────────────────────────────────────────────
# Use a Gmail App Password, NOT your real Gmail password.
# Create one at: myaccount.google.com → Security → App Passwords
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
DIGEST_RECIPIENT=alex@morper.net

# ── Reddit API ───────────────────────────────────────────────────
# Create a free app at: reddit.com/prefs/apps  (type: script)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=40kDigest/1.0 by YourRedditUsername

# ── YouTube Data API ─────────────────────────────────────────────
# Enable YouTube Data API v3 at: console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key

# ── Optional: High-potency alert threshold (default 8) ───────────
ALERT_THRESHOLD=8
